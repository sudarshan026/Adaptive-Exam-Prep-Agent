# Database
DATABASE_URL=sqlite+aiosqlite:///./exam_prep.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/exam_prep

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Gemini API (optional - app works without it in demo mode)
GEMINI_API_KEY=

# YouTube Data API (optional)
YOUTUBE_API_KEY=

# Application
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
